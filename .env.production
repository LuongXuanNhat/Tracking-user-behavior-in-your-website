# .env.production
# Production configuration cho high-load environment

# Database Configuration
CASSANDRA_HOSTS=127.0.0.1:9142
CASSANDRA_LOCAL_DATA_CENTER=datacenter1
CASSANDRA_KEYSPACE=user_behavior_analytics
CASSANDRA_PORT=9142

# Cassandra Authentication (if enabled)
# CASSANDRA_USERNAME=app_user
# CASSANDRA_PASSWORD=app_password

# Application Configuration
NODE_ENV=production
PORT=3002

# Performance Optimization
CASSANDRA_CONNECTION_POOL_SIZE=8
CASSANDRA_READ_TIMEOUT=30000
CASSANDRA_WRITE_TIMEOUT=20000
CASSANDRA_CONNECTION_TIMEOUT=20000

# Load Balancer Endpoints
CASSANDRA_WRITE_ENDPOINT=127.0.0.1:9142
CASSANDRA_READ_ENDPOINT=127.0.0.1:9143
CASSANDRA_DR_ENDPOINT=127.0.0.1:9144

# Monitoring
HAPROXY_STATS_URL=http://127.0.0.1:8404/stats
HAPROXY_HEALTH_URL=http://127.0.0.1:8405/health

# API Keys (production should use database lookup)
DEMO_API_KEY=demo_api_key_12345
TEST_API_KEY=test_api_key_67890
PRODUCTION_API_KEY=prod_api_key_abcdef

# Rate Limiting
API_RATE_LIMIT=1000
API_BURST_LIMIT=100

# Caching (if Redis is available)
# REDIS_URL=redis://localhost:6379
# CACHE_TTL=300

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log
