# Load Balancer Configuration for Cassandra High Availability

# Option 1: Direct connection to multiple nodes (current setup)
CASSANDRA_CONTACT_POINTS=127.0.0.1:9042,127.0.0.1:9043,127.0.0.1:9044
CASSANDRA_LOCAL_DATA_CENTER=datacenter1

# Option 2: Connection through HAProxy load balancer
# CASSANDRA_CONTACT_POINTS=127.0.0.1:9142
# CASSANDRA_USE_LOAD_BALANCER=true

# Database configuration
CASSANDRA_KEYSPACE=user_behavior_analytics
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=

# Performance settings
CASSANDRA_POOL_SIZE=8
CASSANDRA_READ_TIMEOUT=12000
CASSANDRA_CONNECT_TIMEOUT=5000

# High Availability settings for better resilience
CASSANDRA_CONSISTENCY_LEVEL=one

CASSANDRA_RETRY_ATTEMPTS=5
CASSANDRA_RECONNECT_INTERVAL=5000
CASSANDRA_HEALTH_CHECK_INTERVAL=10000
CASSANDRA_MAX_RECONNECT_ATTEMPTS=10
